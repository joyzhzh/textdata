  "contents": [
    {
      "path": "tool/",
      "what": "the toolkit's agent skill: instructions, six references, eight schemas, three helpers, three templates, a synthetic fixture and input text, two test files (50 tests)",
      "edition": "release edition; modifications noted in CHANGES.md"
    },
    {
      "path": "example/input/study/",
      "what": "the sealed third-cycle records of the 22-interview study, the two selection records, the analytical account, the review and the producers' dispositions",
      "edition": "release inspection edition: seven original analytical files unchanged; duplicate handoff omitted; INPUT_MANIFEST.json and MANIFEST.json are declared derivatives; original and release fingerprints are separate"
    },
    {
      "path": "example/trace_comparison.py, example/output/TRACE.md",
      "what": "the worked example: one analytical chain traced through the records",
      "edition": "written for this release"
    },
    {
      "path": "checks/",
      "what": "the verification a reviewer runs, and the script that regenerates this manifest",
      "edition": "written for this release"
    },
    {
      "path": "README.md, NOTICE.md, CHANGES.md, data/README.md, example/README.md",
