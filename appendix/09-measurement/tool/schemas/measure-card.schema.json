      "minLength": 1,
      "pattern": "\\S"
    },
    "work_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "schema_version": {
      "const": "2.0"
    },
    "record_type": {
      "const": "measure_card"
    },
    "rights": {
      "const": "permitted"
    },
    "teaching_example": {
      "type": "boolean"
    },
    "review_status": {
      "const": "unreviewed"
    },
