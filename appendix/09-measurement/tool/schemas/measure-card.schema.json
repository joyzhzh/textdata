{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:textdata:toolkits:measurement:measure-card-schema:2.0",
  "title": "Nine-section measure card v2",
  "description": "Structural contract only. Source admission is an external v3 verdict on exact frozen records. Unknowns are explicit, not grounds for filling facts from memory.",
  "$defs": {
    "field": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "status",
            "value",
            "reason",
            "locator"
          ],
          "properties": {
            "status": {
              "const": "reported"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string"
            },
            "locator": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "value",
            "reason",
            "locator"
          ],
          "properties": {
            "status": {
              "const": "unknown"
            },
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "locator": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "value",
            "reason",
            "locator"
          ],
          "properties": {
            "status": {
              "const": "not_applicable"
            },
            "value": {
              "type": "null"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "locator": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "value",
            "reason",
            "locator"
          ],
          "properties": {
            "status": {
              "const": "proposed"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "locator": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "id",
    "claim",
    "source",
    "locator",
    "support",
    "limitations",
    "work_id",
    "schema_version",
    "record_type",
    "rights",
    "teaching_example",
    "review_status",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "claim": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "locator": {
